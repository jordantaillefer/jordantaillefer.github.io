---
import Base from '../layouts/Base.astro';
import Monogram from '../components/Monogram.astro';
import { site } from '../content/site';
import CvMission from '../components/CvMission.astro';
import ContactIcon from '../components/ContactIcon.astro';
import { cv } from '../content/cv';
import { method } from '../content/method';
import { projects } from '../content/projects';
import { workstation } from '../content/workstation';
import { allGrowth, formatDay, formatMonth, snapshot } from '../data/snapshot';

const host = (url: string) => url.replace('https://', '').replace('www.', '').replace(/\/$/, '');
const [freelance, octo, excilys] = cv.experiences;

// La mise en page est fixée feuille par feuille : la sidebar sombre court ainsi en
// pleine hauteur sur les deux pages, et un test vérifie que rien ne déborde.
const octoPage1 = octo.missions.slice(0, 2);
const octoPage2 = octo.missions.slice(2);

const figures = [
  { value: '9 ans', label: 'de développement fullstack, dont 4 chez OCTO Technology' },
  {
    value: `×${Math.floor(allGrowth.ratio)}`,
    label: `commits par mois, tous projets, entre 2025 et ${formatMonth(allGrowth.reference.month)}`,
  },
];

const contacts = [
  { icon: 'email', label: site.contact.email, href: `mailto:${site.contact.email}` },
  { icon: 'phone', label: cv.phone },
  { icon: 'linkedin', label: host(site.contact.linkedin), href: site.contact.linkedin },
  { icon: 'github', label: host(site.contact.github), href: site.contact.github },
  { icon: 'site', label: 'jordantaillefer.github.io', href: 'https://jordantaillefer.github.io' },
] as const;
---

<Base title="CV · Jordan Taillefer" description="CV de Jordan Taillefer, product developer fullstack TypeScript." noindex>
  <div class="sheets">
    <article class="sheet">
      <aside class="sheet-side">
        <Monogram size={92} idPrefix="cv" />
        <div>
          <h1>Jordan<br />Taillefer</h1>
          <p class="side-role">Product developer fullstack TypeScript</p>
          <p class="side-status">{site.status} · {site.location}</p>
        </div>

        <section>
          <h2>Contact</h2>
          <ul class="contact">
            {
              contacts.map((contact) => (
                <li>
                  <ContactIcon name={contact.icon} />
                  {'href' in contact ? <a href={contact.href}>{contact.label}</a> : <span>{contact.label}</span>}
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2>En chiffres</h2>
          {figures.map((figure) => <div class="figure"><b>{figure.value}</b><span>{figure.label}</span></div>)}
        </section>

        <section>
          <h2>Stack</h2>
          <div class="chips">{cv.stack.map((tech) => <span class="chip">{tech}</span>)}</div>
        </section>

        <section>
          <h2>Développement augmenté</h2>
          <div class="chips">{cv.ai.map((item) => <span class="chip chip-accent">{item}</span>)}</div>
        </section>
      </aside>

      <main class="sheet-main">
        <p class="pitch">{site.headline[0]} <span>{site.headline[1]}</span></p>
        <p class="intro">{site.intro} {site.credibility}</p>

        <h2 class="section-title">Expérience</h2>
        <section class="job">
          <header class="job-head">
            <h3>{freelance.title} · {freelance.company}</h3>
            <p class="job-meta">{freelance.period} · {freelance.location}</p>
          </header>
          {freelance.missions.map((mission) => <CvMission mission={mission} featured />)}
        </section>

        <section class="job">
          <header class="job-head">
            <h3>{octo.title} · {octo.company}</h3>
            <p class="job-meta">{octo.period} · {octo.location}</p>
          </header>
          {octoPage1.map((mission) => <CvMission mission={mission} />)}
        </section>
      </main>
    </article>

    <article class="sheet">
      <aside class="sheet-side">
        <section>
          <h2>Méthode</h2>
          <ol class="method">{method.map((step) => <li><b>{step.title}</b></li>)}</ol>
          <p class="side-quote">L'IA prépare le terrain. Les humains décident.</p>
        </section>

        <section>
          <h2>Projets perso</h2>
          {
            projects.map((project) => (
              <div class="side-project">
                <b>{project.name}</b>
                <span>{project.pitch}</span>
                {project.id === 'kauri' && (
                  <span class="muted">
                    {snapshot.kauri.commits} commits · {snapshot.kauri.specs} specs · {snapshot.kauri.testFiles} fichiers de tests
                  </span>
                )}
                {project.url && <a href={project.url}>{host(project.url)}</a>}
              </div>
            ))
          }
        </section>

        <section>
          <h2>Outillage</h2>
          <ul class="tools">
            {workstation.tools.map((tool) => <li>{tool.name}</li>)}
            <li>Skills : {workstation.skills.map((skill) => skill.name).join(', ')}</li>
          </ul>
        </section>

        <p class="side-foot">{cv.company.name}<br />SIREN {cv.company.siren}<br />Chiffres mesurés le {formatDay(snapshot.measuredAt)}</p>
      </aside>

      <main class="sheet-main">
        <section class="job">
          <header class="job-head">
            <h3>{octo.company} <span class="cont">(suite)</span></h3>
            <p class="job-meta">{octo.period}</p>
          </header>
          {octoPage2.map((mission) => <CvMission mission={mission} />)}
        </section>

        <section class="job">
          <header class="job-head">
            <h3>{excilys.title} · {excilys.company}</h3>
            <p class="job-meta">{excilys.period} · {excilys.location}</p>
          </header>
          {excilys.missions.map((mission) => <CvMission mission={mission} />)}
        </section>
      </main>
    </article>
  </div>
</Base>

<style is:global>
  @page { size: A4; margin: 0; }
  html:has(.sheets), body:has(.sheets) { background: #e9ebef; color: #1b1d22; color-scheme: light; }
  @media print { html:has(.sheets), body:has(.sheets) { background: #fff; } }
</style>

<style>
  .sheets { display: grid; gap: 24px; justify-content: center; padding: 24px 0; overflow-x: auto; }
  @media print { .sheets { display: block; padding: 0; gap: 0; } }
  .sheet {
    width: 210mm;
    height: 297mm;
    display: grid;
    grid-template-columns: 66mm 1fr;
    background: #fff;
    overflow: hidden;
    break-after: page;
    box-shadow: 0 10px 30px rgba(20, 22, 27, 0.18);
  }
  @media print { .sheet { box-shadow: none; } }
  .sheet:last-child { break-after: auto; }

  /* Sidebar : l'ADN du site */
  .sheet-side {
    background: var(--color-bg);
    background-image: radial-gradient(90% 40% at 0% 0%, color-mix(in oklab, var(--color-accent-from) 12%, transparent), transparent 70%);
    color: var(--color-fg);
    padding: 13mm 8mm 10mm 9mm;
    display: flex;
    flex-direction: column;
    gap: 6mm;
    overflow: hidden;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  h1 { font-size: 22pt; line-height: 1.02; letter-spacing: -0.04em; }
  .side-role { margin-top: 6px; font: 600 9.5pt var(--font-display); color: var(--color-accent-from); letter-spacing: -0.01em; }
  .side-status { font-size: 8.5pt; color: var(--color-fg-2); margin-top: 2px; }
  .sheet-side h2 { font: 700 7pt var(--font-body); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-fg-dim); margin-bottom: 3mm; }
  .contact { list-style: none; padding: 0; display: grid; gap: 5px; font-size: 8.3pt; color: #c9cfdb; }
  .contact li { display: flex; align-items: center; gap: 7px; }
  .contact :global(svg) { flex: none; width: 13px; height: 13px; color: var(--color-accent-from); --icon-cut: var(--color-bg); }
  a { color: inherit; text-decoration: none; }
  .figure { display: grid; grid-template-columns: 17mm 1fr; align-items: baseline; gap: 2mm; margin-bottom: 2.4mm; }
  .figure b { font: 700 14pt var(--font-display); letter-spacing: -0.04em; color: var(--color-accent-from); }
  .figure span { font-size: 7.8pt; line-height: 1.3; color: #c9cfdb; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; }
  .chip { font-size: 7.6pt; font-weight: 600; background: var(--color-raise); color: var(--color-fg); border-radius: 999px; padding: 2px 8px; }
  .chip-accent { background: color-mix(in oklab, var(--color-accent-from) 18%, var(--color-raise)); }
  .method { padding-left: 15px; display: grid; gap: 2px; font-size: 8.3pt; color: #c9cfdb; }
  .method li::marker { color: var(--color-accent-from); font-weight: 700; }
  .method b { color: var(--color-fg); font-weight: 600; }
  .side-quote { margin-top: 3mm; font: 700 10pt/1.25 var(--font-display); letter-spacing: -0.02em; }
  .side-project { display: grid; gap: 1px; margin-bottom: 3mm; font-size: 8pt; color: #c9cfdb; }
  .side-project b { font: 700 9.5pt var(--font-display); color: var(--color-fg); }
  .side-project a { color: var(--color-accent-from); }
  .muted { color: var(--color-fg-dim); }
  .tools { list-style: none; padding: 0; display: grid; gap: 3px; font-size: 8pt; color: #c9cfdb; }
  .side-foot { margin-top: auto; font-size: 7pt; line-height: 1.5; color: var(--color-fg-dim); }

  /* Colonne principale : le parcours */
  .sheet-main { padding: 13mm 11mm 10mm 10mm; overflow: hidden; }
  .pitch { font: 700 15pt/1.15 var(--font-display); letter-spacing: -0.03em; }
  .pitch span { color: #0b6e52; }
  .intro { margin-top: 2.5mm; font-size: 9pt; color: #4b5260; line-height: 1.45; }
  .section-title { margin: 6mm 0 3mm; font: 700 8pt var(--font-body); letter-spacing: 0.14em; text-transform: uppercase; color: #0b6e52; padding-bottom: 1.5mm; border-bottom: 2px solid var(--color-accent-from); }
  .job + .job { margin-top: 4mm; }
  .job-head { margin-bottom: 2.5mm; }
  .job-head h3 { font-size: 11.5pt; letter-spacing: -0.02em; }
  .cont { font-weight: 500; color: #6a7180; font-size: 9pt; }
  .job-meta { font-size: 8.3pt; color: #6a7180; margin-top: 1px; }
  .job :global(.mission + .mission) { margin-top: 1.5mm; }
</style>
