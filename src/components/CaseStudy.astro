---
import type { CaseStudy } from '../content/cases';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

<article class="case" data-case={study.id}>
  <p class="label case-period">{study.period}</p>
  <h3>{study.title}</h3>
  <p class="case-summary">{study.summary}</p>
  <dl class="metrics">
    {
      study.metrics.map((metric) => (
        <div class="metric">
          <dt>{metric.label}</dt>
          <dd>
            {metric.before && (
              <>
                <s>{metric.before}</s>
                <span class="arrow" aria-label="devient">→</span>
              </>
            )}
            <strong>{metric.after}</strong>
            {metric.note && <small>{metric.note}</small>}
          </dd>
        </div>
      ))
    }
  </dl>
  <ul class="controls" aria-label="Garde-fous">
    {study.controls.map((control) => <li>{control}</li>)}
  </ul>
  <p class="lesson">{study.lesson}</p>
</article>

<style>
  .case { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-xl); padding: 24px; box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .case-period { color: var(--color-blue); }
  .case[data-case='emotion'] .case-period { color: var(--color-amber); }
  h3 { font-size: 22px; letter-spacing: var(--tracking-display); }
  .case-summary { color: var(--color-fg-2); font-size: 14.5px; }
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 8px; }
  .metric { background: var(--color-raise); border-radius: var(--radius-md); padding: 12px 14px; }
  dt { font-size: 12.5px; color: var(--color-fg-2); }
  dd { margin-top: 4px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; }
  dd s { color: var(--color-fg-dim); font-size: 14px; }
  .arrow { color: var(--color-fg-dim); font-size: 13px; }
  dd strong { font: 700 22px/1.1 var(--font-display); letter-spacing: var(--tracking-display-tight); }
  dd small { flex-basis: 100%; font-size: 12px; color: var(--color-fg-dim); }
  .controls { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .controls li { font-size: 12px; font-weight: 600; color: var(--color-fg-2); background: var(--color-raise); border-radius: 999px; padding: 4px 10px; }
  .lesson { border-top: 1px dashed var(--color-line); padding-top: 12px; font-size: 14px; color: var(--color-fg); }
</style>
