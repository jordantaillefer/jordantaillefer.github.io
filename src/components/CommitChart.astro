---
import type { MonthPoint } from '../lib/stats';
import ChartSvg from './ChartSvg.astro';
import { formatDay } from '../data/snapshot';

interface Props {
  series: MonthPoint[];
  measuredAt: string;
  baselineAvg: number;
}

const { series, measuredAt, baselineAvg } = Astro.props;
// Sur mobile, toute la série rendrait le texte illisible et un défilement cacherait
// justement les mois récents : on n'y montre que les 12 derniers, en grand.
const MOBILE_MONTHS = 12;
---

<figure class="chart">
  <div class="full"><ChartSvg series={series} baselineAvg={baselineAvg} /></div>
  <div class="recent"><ChartSvg series={series.slice(-MOBILE_MONTHS)} baselineAvg={baselineAvg} compact /></div>
  <figcaption>
    <span class="recent-note">Les 12 derniers mois. </span>Barre hachurée : mois en cours. Mesuré le {formatDay(measuredAt)}.
  </figcaption>
</figure>

<script>
  // Les barres poussent quand le graphique entre à l'écran. Sans JS ou sous
  // « réduire les animations », elles sont simplement pleines.
  const charts = document.querySelectorAll<HTMLElement>('.chart');
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.35 },
    );
    charts.forEach((chart) => {
      chart.classList.add('armed');
      observer.observe(chart);
    });
  }
</script>

<style>
  .chart { margin: 0; }
  .recent, .recent-note { display: none; }
  @media (max-width: 700px) {
    .full { display: none; }
    .recent { display: block; }
    .recent-note { display: inline; }
  }
  figcaption { margin-top: 10px; font-size: 12.5px; color: var(--color-fg-dim); }
</style>
