---
import { MONOGRAM } from '../lib/pen/monogram';
import { INK_FROM, INK_TO, MONOGRAM_INK } from '../lib/pen/render';

interface Props {
  /** Largeur en pixels ; la hauteur suit le ratio 140 × 110. */
  size: number;
  animated?: boolean;
  idPrefix?: string;
  label?: string;
}

const { size, animated = false, idPrefix = 'jt', label } = Astro.props;
const height = Math.round((size * 110) / 140);
const gradientId = `${idPrefix}-ink`;
---

<svg
  class="monogram"
  width={size}
  height={height}
  viewBox={MONOGRAM.viewBox}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <linearGradient id={gradientId} gradientUnits="userSpaceOnUse" x1="10" y1="20" x2="130" y2="95">
      <stop offset="0" stop-color={INK_FROM}></stop>
      <stop offset="1" stop-color={INK_TO}></stop>
    </linearGradient>
    {
      animated &&
        MONOGRAM_INK.map((stroke) => (
          <mask id={`${idPrefix}-${stroke.id}`} maskUnits="userSpaceOnUse" x="0" y="0" width="140" height="110">
            <path
              class="pen-mask"
              data-anim
              d={stroke.d}
              fill="none"
              stroke="#fff"
              stroke-width="13"
              pathLength="1"
              stroke-dasharray="1"
              style={`--dur:${stroke.durMs}ms;--delay:${stroke.delayMs}ms`}
            ></path>
          </mask>
        ))
    }
  </defs>
  {
    MONOGRAM_INK.map((stroke) => (
      <g mask={animated ? `url(#${idPrefix}-${stroke.id})` : undefined}>
        <path d={stroke.ink} fill={`url(#${gradientId})`}></path>
        <!-- Un filet continu sous les déliés, pour qu'ils ne disparaissent jamais. -->
        <path d={stroke.d} fill="none" stroke={`url(#${gradientId})`} stroke-width="0.9" stroke-linecap="round"></path>
      </g>
    ))
  }
</svg>

<style>
  .pen-mask {
    stroke-dashoffset: 1;
    animation: pen-write var(--dur) var(--ease-pen) var(--delay) both;
  }
  @keyframes pen-write {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pen-mask { stroke-dashoffset: 0; }
  }
</style>
