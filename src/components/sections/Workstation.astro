---
import ItermMock from '../ItermMock.astro';
import { vibeCodingNuance, workstation } from '../../content/workstation';

const legend = [
  { color: '#4f8dff', label: 'Claude travaille' },
  { color: 'var(--color-amber)', label: "attend une action de ma part" },
  { color: 'var(--color-accent-from)', label: 'terminé' },
  { color: 'var(--color-coral)', label: 'erreur' },
];
---

<section id="poste" class="section">
  <div class="container">
    <div class="section-head">
      <p class="label">Mon poste</p>
      <h2>Plusieurs agents, un seul pilote.</h2>
      <p class="section-intro">
        Trois sessions Claude sur Pilote, une par worktree, et mes projets perso à côté. Pour ne jamais perdre le fil, j'ai outillé mon poste.
      </p>
    </div>

    <div class="setup">
      <ItermMock left={workstation.iterm.left} right={workstation.iterm.right} />
      <ul class="legend" aria-label="Couleur des onglets">
        {legend.map((item) => <li><span style={`background:${item.color}`}></span>{item.label}</li>)}
      </ul>
    </div>

    <div class="tools">
      {
        workstation.tools.map((tool) => (
          <article class="tool">
            <h3>{tool.url ? <a href={tool.url}>{tool.name} ↗</a> : tool.name}</h3>
            <p>{tool.what}</p>
            {tool.note && <p class="tool-note">{tool.note}</p>}
          </article>
        ))
      }
    </div>

    <div class="skills">
      <div class="skills-head">
        <h3>Mes skills Claude Code</h3>
        <p>Un skill, c'est une action que je n'ai pas envie de refaire à la main.</p>
      </div>
      <dl>
        {
          workstation.skills.map((skill) => (
            <div class="skill">
              <dt>{skill.name}</dt>
              <dd>{skill.what}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <p class="nuance">{vibeCodingNuance}</p>
  </div>
</section>

<style>
  .setup { margin-top: 28px; }
  .legend { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 12px; font-size: 13px; color: var(--color-fg-2); }
  .legend li { display: flex; align-items: center; gap: 8px; }
  .legend span { width: 10px; height: 10px; border-radius: 50%; }
  .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; margin-top: 24px; }
  .tool { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg); padding: 18px; box-shadow: var(--shadow-card); }
  .tool h3 { font-size: 17px; letter-spacing: var(--tracking-display); }
  .tool h3 a { text-decoration: none; }
  .tool h3 a:hover { color: var(--color-accent-from); }
  .tool p { margin-top: 8px; font-size: 13.5px; color: var(--color-fg-2); }
  .tool-note { border-left: 2px solid var(--color-amber); padding-left: 10px; color: var(--color-fg) !important; }
  .skills { margin-top: 16px; display: grid; grid-template-columns: 1fr 2fr; gap: 24px; background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-xl); padding: 24px; box-shadow: var(--shadow-card); }
  .skills-head h3 { font-size: 19px; letter-spacing: var(--tracking-display); }
  .skills-head p { margin-top: 8px; font-size: 14px; color: var(--color-fg-2); }
  dl { display: grid; gap: 10px; }
  .skill { display: grid; grid-template-columns: 190px 1fr; gap: 12px; align-items: baseline; }
  dt { font: 500 13px var(--font-mono); color: var(--color-accent-from); }
  dd { font-size: 13.5px; color: var(--color-fg-2); }
  .nuance { margin-top: 16px; font: 700 18px/1.3 var(--font-display); letter-spacing: var(--tracking-display); }
  @media (max-width: 760px) {
    .skills { grid-template-columns: 1fr; }
    .skill { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
