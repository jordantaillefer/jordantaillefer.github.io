---
import { siGithub } from 'simple-icons';

interface Props {
  name: 'email' | 'phone' | 'linkedin' | 'github' | 'site';
}

const { name } = Astro.props;
---

{
  name === 'github' ? (
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} fill="currentColor" /></svg>
  ) : name === 'linkedin' ? (
    // Simple Icons ne fournit plus le logo LinkedIn : un « in » sobre dans un carré arrondi.
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="2" y="2" width="20" height="20" rx="4" fill="currentColor" />
      <circle cx="7.6" cy="7.4" r="1.7" fill="var(--icon-cut, #14161b)" />
      <rect x="6.1" y="10" width="3" height="8" rx="0.6" fill="var(--icon-cut, #14161b)" />
      <path d="M11.4 10h2.8v1.2c.5-.8 1.5-1.4 2.7-1.4 2 0 3 1.3 3 3.6V18h-3v-4.2c0-1-.4-1.6-1.3-1.6s-1.3.6-1.3 1.6V18h-2.9z" fill="var(--icon-cut, #14161b)" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      {name === 'email' && (
        <>
          <rect x="3" y="5" width="18" height="14" rx="2.5" />
          <path d="m4 7 8 6 8-6" />
        </>
      )}
      {name === 'phone' && <path d="M5 4h3.5l1.5 4-2 1.3a10 10 0 0 0 6.7 6.7L16 14l4 1.5V19a1.5 1.5 0 0 1-1.6 1.5A15 15 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z" />}
      {name === 'site' && (
        <>
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
        </>
      )}
    </svg>
  )
}
